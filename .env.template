# Copy this file to `.env` at the repository root and fill in what you need.
#   cp .env.template .env
#
# Everything is OpenAI-compatible, so the same notebooks run against a cloud
# provider, a self-hosted server, or a local one. Only the first three values
# are required. Blank means "use the default", which is noted per line.
#
# Nothing in this file belongs in a notebook. If you want a different timeout,
# a different reasoning budget, or a different model, change it here.

# ── Chat model (required) ────────────────────────────────────────────────────
# THREE WAYS to point this at a model:
#
# (1) Accenture Titanium APIM gateway (bootcamp default) — one key drives all
#     model access. Paste your individual APIM key ONCE and every downstream
#     key resolves via ${APIM_KEY} interpolation.
#       APIM_KEY=<your-individual-apim-key>
#       OPENAI_API_KEY=${APIM_KEY}
#       OPENAI_BASE_URL=https://lgts1tetamapi01.azure-api.net/gpt51/openai
#       LLM_MODEL=gpt-5.5
#
# (2) Direct to OpenAI: leave OPENAI_BASE_URL blank and set a real key.
#       OPENAI_API_KEY=sk-proj-...
#       OPENAI_BASE_URL=
#       LLM_MODEL=gpt-5.6-luna
#
# (3) Self-hosted / local (Unsloth Studio, vLLM, Ollama, LM Studio): any
#     non-empty key works, and the base URL ends in /v1.
#       OPENAI_API_KEY=sk-unsloth-...
#       OPENAI_BASE_URL=http://127.0.0.1:8888/v1
#       LLM_MODEL=unsloth/Qwen3.6-35B-A3B-MTP-GGUF
APIM_KEY=
OPENAI_API_KEY=${APIM_KEY}
OPENAI_BASE_URL=https://lgts1tetamapi01.azure-api.net/gpt51/openai
LLM_MODEL=gpt-5.5

# ── Embeddings ───────────────────────────────────────────────────────────────
# Blank base URL means "the same endpoint as the chat model". On APIM the
# embeddings live at a different path (/openai, not /gpt51/openai) so set it.
#   OpenAI:       EMBED_MODEL=text-embedding-3-small
#   APIM:         EMBED_BASE_URL=https://lgts1tetamapi01.azure-api.net/openai
#                 EMBED_MODEL=text-embedding-3-large
#   Self-hosted:  EMBED_MODEL=Qwen/Qwen3-Embedding-4B-GGUF
EMBED_API_KEY=${APIM_KEY}
EMBED_BASE_URL=https://lgts1tetamapi01.azure-api.net/openai
EMBED_MODEL=text-embedding-3-large

# ── Judging ──────────────────────────────────────────────────────────────────
# Blank means the judge is the same model that wrote the answer, which is
# convenient and is a limitation. Point it at a second model when you can.
#   JUDGE_MODEL=gpt-5.6-luna
JUDGE_MODEL=

# ── Synthetic data and RAGAS ─────────────────────────────────────────────────
# Blank means the chat model above. The generator makes many calls, so a
# faster or cheaper model here is usually the right call.
RAGAS_BASE_URL=https://lgts1tetamapi01.azure-api.net/gpt51/openai
RAGAS_MODEL=gpt-5.5
SDG_MODEL=gpt-5.5

# ── Tuning ───────────────────────────────────────────────────────────────────
# Seconds before a single call gives up. Be generous: a reasoning model on a
# long prompt can think for minutes, and a timeout mid-run loses the work.
#   LLM_TIMEOUT=600
LLM_TIMEOUT=

# Retries on a 429 or a 5xx. Other errors surface immediately.
#   LLM_MAX_RETRIES=3
LLM_MAX_RETRIES=

# Blank means send no temperature and let the model decide, which is what a
# reasoning model wants. Judges are pinned separately, below.
#   LLM_TEMPERATURE=
LLM_TEMPERATURE=

# Judges score the same answer the same way twice, so pin this at 0.
#   JUDGE_TEMPERATURE=0
JUDGE_TEMPERATURE=

# Blank means no cap, and blank is almost always right. A cap truncates a
# reasoning model mid-thought and you get a half-finished answer with no error.
# Set it only if you are billed by the token and must bound the spend.
#   LLM_MAX_TOKENS=
LLM_MAX_TOKENS=

# How hard the model thinks before answering: low, medium, or high. Blank sends
# nothing, which suits a model with no reasoning budget. Models that do not
# support it ignore it, and the helper retries once without it if one refuses.
#   LLM_REASONING_EFFORT=medium
LLM_REASONING_EFFORT=

# Blank embed timeout means the same as LLM_TIMEOUT. Batch size is how many
# texts go in one embeddings call; lower it if your server rejects large bodies.
#   EMBED_TIMEOUT=
#   EMBED_BATCH=64
EMBED_TIMEOUT=
EMBED_BATCH=

# ── Optional services ────────────────────────────────────────────────────────
# Web research. Two notebooks use it and both skip cleanly when it is blank.
#   TAVILY_API_KEY=tvly-...
TAVILY_API_KEY=

# Second-stage reranking. Cohere Rerank is available through APIM using the
# same personal APIM key; no separate rerank key needed.
#   COHERE_API_KEY=<any-cohere-or-apim-key>
COHERE_API_KEY=${APIM_KEY}
COHERE_BASE_URL=https://lgts1tetamapi01.azure-api.net
COHERE_MODEL=Cohere-rerank-v4.0-pro

# Anthropic Claude via APIM. Uses your APIM key.
ANTHROPIC_API_KEY=${APIM_KEY}
ANTHROPIC_BASE_URL=https://lgts1tetamapi01.azure-api.net/claude/anthropic/v1/messages
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Speech (Module 14 only) ──────────────────────────────────────────────────
# Two modes:
#
# (A) Azure AI Speech — VNet-restricted, requires Accenture VPN. Module 14
#     auto-detects Azure when *_BASE_URL contains cognitiveservices.azure.com.
#     Paste the shared Speech key once at SPEECH_KEY; STT_API_KEY and
#     TTS_API_KEY interpolate from it.
#       SPEECH_KEY=<shared-speech-key-from-sharepoint>
#       STT_BASE_URL=https://lgts1tetamsph01.cognitiveservices.azure.com/
#       TTS_BASE_URL=https://lgts1tetamsph01.cognitiveservices.azure.com/
#
# (B) Local Parakeet/Kokoro fallback — no VPN needed, requires the local
#     servers running. Set STT_BASE / TTS_BASE and leave the *_BASE_URL vars blank.
SPEECH_KEY=
STT_BASE_URL=https://lgts1tetamsph01.cognitiveservices.azure.com/
STT_API_KEY=${SPEECH_KEY}
TTS_BASE_URL=https://lgts1tetamsph01.cognitiveservices.azure.com/
TTS_API_KEY=${SPEECH_KEY}

# Local speech fallback (only when the *_BASE_URL values above are blank).
#   STT_BASE=http://localhost:8001
#   STT_MODEL=parakeet-tdt-0.6b-v3
#   TTS_BASE=http://localhost:8002
#   TTS_MODEL=model
STT_BASE=
STT_MODEL=
TTS_BASE=
TTS_MODEL=
TTS_KEY=

# ── Workspace ────────────────────────────────────────────────────────────────
# Where the cohort's artifacts live. Blank means ./workspace. Set it to
# data/seed only when regenerating the seed example.
TE_WORKSPACE=
# 1 means small budgets and fixed seeds. `make seed` sets it for you.
TE_SEED_MODE=
